{
  "filters": {
    "and": [
      "file.ext == \"md\"",
      "note.type == \"project\"",
      "!file.inFolder(\"90 System\")",
      "note.area == this.file.asLink()",
      "note.status != \"done\""
    ]
  },
  "properties": {
    "file.name": {
      "displayName": "Project"
    },
    "note.status": {
      "displayName": "Status"
    },
    "note.next": {
      "displayName": "Next step"
    },
    "note.waiting_on": {
      "displayName": "Waiting on"
    },
    "note.due": {
      "displayName": "Due"
    },
    "note.area": {
      "displayName": "Area"
    },
    "note.completed": {
      "displayName": "Completed"
    }
  },
  "views": [
    {
      "type": "table",
      "name": "Projects",
      "filters": "true",
      "order": [
        "file.name",
        "note.next",
        "note.waiting_on",
        "note.due",
        "note.area"
      ],
      "sort": [
        {
          "property": "note.due",
          "direction": "ASC"
        },
        {
          "property": "file.name",
          "direction": "ASC"
        }
      ]
    }
  ]
}
